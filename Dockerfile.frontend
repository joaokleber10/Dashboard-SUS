# Estágio 1: build do React (Vite). VITE_API_URL é embutida no bundle em tempo de build.
ARG NODE_VERSION=20
FROM node:${NODE_VERSION}-alpine AS build

WORKDIR /app
# Só o package.json (sem o package-lock.json): um lockfile gerado no Windows pode não trazer os
# binários nativos do Linux (rollup/esbuild) e quebrar o build. O npm resolve de novo dentro do Linux.
COPY frontend/package.json ./
RUN npm install

COPY frontend/ ./
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# Estágio 2: só arquivos estáticos servidos pelo Nginx.
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
