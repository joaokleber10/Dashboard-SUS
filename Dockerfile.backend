# Imagem única do backend: serve a API (padrão) e roda o ETL (command override no compose).
ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Compilador: dependências do PySUS (leitura de .dbc) podem precisar compilar em Linux.
# Se o build passar sem isto, a linha pode ser removida para encolher a imagem.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY src ./src

EXPOSE 8000
CMD ["sh", "-c", "python -m uvicorn src.app:app --host ${BACKEND_HOST:-0.0.0.0} --port ${BACKEND_PORT:-8000}"]
