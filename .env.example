# ===== Dados =====
# Dentro do Docker o WORKDIR é /app, então "./data" e "/app/data" apontam para o mesmo lugar.
FOCO_UF=PB
FOCO_MUNICIPIO=Patos
FONTES_DIR=refs/fontes
CID10_PATH=refs/cid10.csv
DATA_DIR=/app/data
DUCKDB_PATH=/app/data/sus.duckdb
PYSUS_CACHEPATH=/app/data/pysus_cache
# UF (ou lista separada por vírgula) e intervalo de anos do ETL
ETL_UF=PB
ETL_YEAR_START=2023
ETL_YEAR_END=2026
ETL_SOURCE=SIH

# ===== Backend =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Origens liberadas no CORS (separadas por vírgula): precisa incluir a URL do frontend
CORS_ORIGINS=http://localhost:5173

# Máximo de linhas no CSV exportado
EXPORT_MAX_ROWS=500000

# ===== Frontend =====
FRONTEND_PORT=5173
# URL da API vista PELO NAVEGADOR. É embutida no build: mudou? rode "docker compose up --build".
VITE_API_URL=http://localhost:8000

# ===== Imagens =====
PYTHON_VERSION=3.12
NODE_VERSION=20
